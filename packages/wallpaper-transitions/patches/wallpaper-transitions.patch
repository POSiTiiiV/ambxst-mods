--- a/modules/globals/GlobalStates.qml
+++ b/modules/globals/GlobalStates.qml
@@ -190,6 +190,79 @@ Singleton {
         wallpaperSelectedIndex = -1;
     }
 
+    // Wallpaper Transitions & Automation State (persisted via StateService)
+    property string wallpaperTransitionStyle: StateService.get("wallpaperTransitionStyle", "crossfade")
+    property string wallpaperTransitionEasing: StateService.get("wallpaperTransitionEasing", "cubic")
+    property int wallpaperTransitionDuration: StateService.get("wallpaperTransitionDuration", 400)
+    property bool wallpapersTabShowSettings: false
+    property bool wallpaperPeriodicEnabled: StateService.get("wallpaperPeriodicEnabled", false)
+    property int wallpaperPeriodicInterval: StateService.get("wallpaperPeriodicInterval", 15)
+
+    function setWallpaperTransitionStyle(style) {
+        wallpaperTransitionStyle = style;
+        StateService.set("wallpaperTransitionStyle", style);
+    }
+
+    function setWallpaperTransitionEasing(easing) {
+        wallpaperTransitionEasing = easing;
+        StateService.set("wallpaperTransitionEasing", easing);
+    }
+
+    function setWallpaperTransitionDuration(duration) {
+        wallpaperTransitionDuration = duration;
+        StateService.set("wallpaperTransitionDuration", duration);
+    }
+
+    function setWallpaperPeriodicEnabled(enabled) {
+        wallpaperPeriodicEnabled = enabled;
+        StateService.set("wallpaperPeriodicEnabled", enabled);
+    }
+
+    function setWallpaperPeriodicInterval(interval) {
+        wallpaperPeriodicInterval = interval;
+        StateService.set("wallpaperPeriodicInterval", interval);
+    }
+
+    function triggerRandomWallpaper() {
+        if (!wallpaperManager || !wallpaperManager.wallpaperPaths || wallpaperManager.wallpaperPaths.length === 0) return;
+        let paths = wallpaperManager.wallpaperPaths;
+        if (paths.length <= 1) {
+            wallpaperManager.setWallpaperByIndex(0);
+            wallpaperSelectedIndex = 0;
+            return;
+        }
+        let cur = wallpaperManager.currentIndex >= 0 ? wallpaperManager.currentIndex : wallpaperSelectedIndex;
+        let next = Math.floor(Math.random() * paths.length);
+        if (next === cur) {
+            next = (next + 1) % paths.length;
+        }
+        wallpaperManager.setWallpaperByIndex(next);
+        wallpaperSelectedIndex = next;
+    }
+
+    Timer {
+        id: wallpaperPeriodicTimer
+        interval: Math.max(1, root.wallpaperPeriodicInterval) * 60000
+        repeat: true
+        running: root.wallpaperPeriodicEnabled
+        onTriggered: {
+            root.triggerRandomWallpaper();
+        }
+    }
+
+    Connections {
+        target: StateService
+        function onInitializedChanged() {
+            if (StateService.initialized) {
+                root.wallpaperTransitionStyle = StateService.get("wallpaperTransitionStyle", "crossfade");
+                root.wallpaperTransitionEasing = StateService.get("wallpaperTransitionEasing", "cubic");
+                root.wallpaperTransitionDuration = StateService.get("wallpaperTransitionDuration", 400);
+                root.wallpaperPeriodicEnabled = StateService.get("wallpaperPeriodicEnabled", false);
+                root.wallpaperPeriodicInterval = StateService.get("wallpaperPeriodicInterval", 15);
+            }
+        }
+    }
+
     function getNotchOpen(screenName) {
         let visibilities = Visibilities.getForScreen(screenName);
         return visibilities.launcher || visibilities.dashboard || visibilities.overview || visibilities.presets;
