{
  "$schema": "https://raw.githubusercontent.com/Axenide/Ambxst/dev/docs/mods/manifest.schema.json",
  "manifestVersion": 1,
  "id": "positive.wallpaper-transitions",
  "name": "Wallpaper Transitions",
  "version": "1.3.0",
  "description": "Configurable animated transitions for static images, animated GIFs, and live videos, randomizer shuffle with customizable directory/type pool filtering, and periodic automatic wallpaper rotation. Fully integrated into Dashboard Wallpapers tab and Ambxst CLI/IPC.",
  "license": "MIT",
  "author": "POSiTiiiV",
  "authorUrl": "https://github.com/POSiTiiiV",
  "homepage": "https://github.com/POSiTiiiV/ambxst-mods/tree/main/packages/wallpaper-transitions",
  "compatibility": {
    "api": 1,
    "ambxst": ">=1.3.0 <2.0.0",
    "testedBaseCommits": [
      "af9f8ad4f42d7cd77f57a7c75f6a2a5d1fb59674",
      "480a10cab5c7e381b7910ef70281b7e67ed2c8a1"
    ]
  },
  "dependencies": [],
  "conflicts": [],
  "commands": [],
  "permissions": [
    "Renders animated transitions between desktop wallpapers and manages automatic wallpaper rotation"
  ],
  "operations": [
    {
      "type": "overlay",
      "source": "payload/TransitionWallpaper.qml",
      "target": "modules/widgets/dashboard/wallpapers/TransitionWallpaper.qml"
    },
    {
      "type": "overlay",
      "source": "payload/WallpaperSettingsView.qml",
      "target": "modules/widgets/dashboard/wallpapers/WallpaperSettingsView.qml"
    },
    {
      "type": "patch",
      "source": "patches/wallpaper-transitions.patch"
    }
  ]
}
