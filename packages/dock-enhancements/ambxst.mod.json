{
  "$schema": "https://raw.githubusercontent.com/Axenide/Ambxst/dev/docs/mods/manifest.schema.json",
  "manifestVersion": 1,
  "id": "positive.dock-enhancements",
  "name": "Dock Enhancements",
  "version": "2.1.0",
  "description": "Requires drpezzer.roadie. Adds a setting to control whether floating windows make the dock hide.",
  "license": "MIT",
  "author": "POSiTiiiV",
  "compatibility": {
    "api": 1,
    "ambxst": ">=1.3.12 <2.0.0"
  },
  "dependencies": [
    "drpezzer.roadie"
  ],
  "conflicts": [],
  "commands": [],
  "permissions": [
    "Adjusts dock visibility for floating windows"
  ],
  "settings": {
    "schema": "settings.json"
  },
  "operations": [
    {
      "type": "overlay",
      "source": "payload/modules/services/DockEnhanceService.qml",
      "target": "modules/services/DockEnhanceService.qml"
    },
    {
      "type": "patch",
      "source": "patches/dock-enhancements.patch"
    }
  ]
}
