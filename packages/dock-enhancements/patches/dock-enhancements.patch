diff --git a/modules/dock/DockContent.qml b/modules/dock/DockContent.qml
--- a/modules/dock/DockContent.qml
+++ b/modules/dock/DockContent.qml
@@ -87,8 +87,13 @@
     readonly property var compositorMonitor: AxctlService.monitorFor(screen)
     readonly property var toplevels: (!compositorMonitor || !compositorMonitor.visibleWorkspace || !AxctlService.clients.values) ? [] : AxctlService.clients.values.filter(c => c.workspace.id === compositorMonitor.visibleWorkspace.id && c.monitor === compositorMonitor.id)
 
+    // positive.dock-enhancements: windows that count for the dock. With
+    // "hide for floating" off, floating windows are ignored.
+    readonly property bool hideForFloating: (typeof DockEnhanceService !== "undefined" && DockEnhanceService.hideForFloating !== undefined) ? DockEnhanceService.hideForFloating : (Config.dock?.hideForFloating ?? true)
+    readonly property var effectiveWindows: hideForFloating ? toplevels : toplevels.filter(c => !c.floating)
+
     // Check if there are any windows on the current monitor and workspace
-    readonly property bool hasWindows: toplevels.length > 0
+    readonly property bool hasWindows: effectiveWindows.length > 0
 
     // Fullscreen detection - scoped to this monitor so the effect only
     // applies to the screen that actually has the fullscreen window
diff --git a/modules/widgets/dashboard/controls/ShellPanel.qml b/modules/widgets/dashboard/controls/ShellPanel.qml
index 9723b55d..b1142138 100644
--- a/modules/widgets/dashboard/controls/ShellPanel.qml
+++ b/modules/widgets/dashboard/controls/ShellPanel.qml
@@ -1555,6 +1555,19 @@ Item {
                             }
                         }
 
+                        ToggleRow {
+                            label: "Hide dock for floating windows"
+                            visible: (Config.dock.theme ?? "default") !== "integrated"
+                            checked: (typeof DockEnhanceService !== "undefined" && DockEnhanceService.hideForFloating !== undefined) ? DockEnhanceService.hideForFloating : (Config.dock.hideForFloating ?? true)
+                            onToggled: value => {
+                                if (typeof DockEnhanceService !== "undefined" && typeof ModsService !== "undefined" && typeof ModsService.setSetting === "function") {
+                                    ModsService.setSetting("positive.dock-enhancements", "hideForFloating", value);
+                                }
+                                GlobalStates.markShellChanged();
+                                Config.dock.hideForFloating = value;
+                            }
+                        }
+
                         ToggleRow {
                             label: I18n.t("shell.show_running_indicators")
                             visible: (Config.dock.theme ?? "default") !== "integrated"
