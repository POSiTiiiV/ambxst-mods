+    // Focused-app identity for the currently active workspace, regular or
+    // in the special group -- rawWorkspaceId is always the real Hyprland
+    // workspace id either way, so no branching is needed here anymore.
+    readonly property var activeAppWindow: {
+        const wins = CompositorData.workspaceWindowsMap[rawWorkspaceId] || [];
+        if (wins.length === 0) return null;
+        return wins.reduce(function(best, win) {
+            const bestFocus = (best && best.focusHistoryID !== undefined ? best.focusHistoryID : Infinity);
+            const winFocus = (win && win.focusHistoryID !== undefined ? win.focusHistoryID : Infinity);
+            return winFocus < bestFocus ? win : best;
+        }, null);
+    }
+
+    readonly property var activeAppDesktopEntry: activeAppWindow ? DesktopEntries.heuristicLookup(activeAppWindow.class) : null
+
+    readonly property string activeAppName: {
+        if (activeAppWindow) {
+            if (activeAppDesktopEntry && activeAppDesktopEntry.name) return activeAppDesktopEntry.name;
+            if (activeAppWindow.class) return activeAppWindow.class.charAt(0).toUpperCase() + activeAppWindow.class.slice(1);
+        }
+        // No window focused yet in an empty special slot -- slot numbers
+        // don't carry app identity on their own (that's just a default
+        // window-rule assignment the user can change), so fall back to a
+        // generic label naming the slot itself rather than guessing an app.
+        if (inSpecialWorkspace) {
+            return "Special " + specialSlotNumber;
+        }
+        return "";
+    }
+
+    readonly property string activeAppIconSource: {
+        if (activeAppDesktopEntry && activeAppDesktopEntry.icon) {
+            return Quickshell.iconPath(activeAppDesktopEntry.icon, "image-missing");
+        }
+        if (activeAppWindow) {
+            return Quickshell.iconPath(AppSearch.getCachedIcon(activeAppWindow.class), "image-missing");
+        }
+        if (inSpecialWorkspace) {
+            return Quickshell.iconPath("view-pin", "favorite");
+        }
+        return Quickshell.iconPath("image-missing", "image-missing");
+    }
+
+    // Small gap between the workspace row and the badge, so the badge's own
+    // background chip doesn't visually fuse with the last workspace button.
+    readonly property real activeAppBadgeGap: 6
+
+    // Additive, like the workspace row's own width -- never touches the
+    // workspace button's own size, so the number pill stays stable.
+    readonly property real activeAppBadgeWidth: (orientation === "horizontal" && activeAppName !== "") ? (activeAppBadge.implicitWidth + activeAppBadgeGap) : 0
+    readonly property real activeAppBadgeHeight: (orientation === "vertical" && activeAppName !== "") ? (activeAppBadge.implicitHeight + activeAppBadgeGap) : 0
+
+    implicitWidth: orientation === "vertical" ? baseSize : workspaceButtonSize * effectiveWorkspaceCount + widgetPadding * 2 + activeAppBadgeWidth
+    implicitHeight: orientation === "vertical" ? workspaceButtonSize * effectiveWorkspaceCount + widgetPadding * 2 + activeAppBadgeHeight : baseSize
+
+    Behavior on implicitWidth {
+        enabled: Config.animDuration > 0
+        NumberAnimation {
+            duration: 200
+            easing.type: Easing.OutQuad
+        }
+    }
+    Behavior on implicitHeight {
+        enabled: Config.animDuration > 0
+        NumberAnimation {
+            duration: 200
+            easing.type: Easing.OutQuad
+        }
+    }
 
     readonly property bool effectiveContainBar: Config.bar.containBar && ((Config.bar.frameEnabled !== undefined ? Config.bar.frameEnabled : false))
 
