+
+    // Focused-app badge: a separate element beside the workspace buttons,
+    // shown for the active workspace whether it's regular or in the special
+    // group. Never merged into the workspace number pill itself.
+    Item {
+        id: activeAppBadge
+        visible: opacity > 0
+        opacity: activeAppName !== "" ? 1.0 : 0.0
+        z: 4
+
+        // Position immediately following the workspace buttons, with a small
+        // gap so the chip's own background doesn't fuse with the last button.
+        x: orientation === "horizontal" ? (widgetPadding + workspaceButtonWidth * effectiveWorkspaceCount + activeAppBadgeGap) : widgetPadding
+        y: orientation === "vertical" ? (widgetPadding + workspaceButtonWidth * effectiveWorkspaceCount + activeAppBadgeGap) : widgetPadding
+
+        readonly property real badgeContentWidth: appBadgeRow.implicitWidth + 16
+        readonly property real badgeContentHeight: appBadgeCol.implicitHeight + 16
+
+        implicitWidth: orientation === "horizontal" ? badgeContentWidth : workspaceButtonWidth
+        implicitHeight: orientation === "vertical" ? badgeContentHeight : workspaceButtonWidth
+
+        width: implicitWidth
+        height: implicitHeight
+
+        Behavior on opacity {
+            enabled: Config.animDuration > 0
+            NumberAnimation {
+                duration: 180
+                easing.type: Easing.OutQuad
+            }
+        }
+
+        // Subtle background chip -- makes the badge read as a distinct group
+        // without a hard edge. "internalbg" resolves to the same "background"
+        // token as the bar's own fill (invisible on top of it); "common"
+        // uses the "surface" token instead, giving real contrast while still
+        // being a standard, theme-synced shell surface.
+        StyledRect {
+            id: appBadgeBg
+            variant: "common"
+            anchors.fill: parent
+            radius: workspacesWidget.radius > 0 ? Math.max(workspacesWidget.radius - widgetPadding, 0) : 0
+        }
+
+        // Horizontal layout: icon + label
+        RowLayout {
+            id: appBadgeRow
+            visible: orientation === "horizontal"
+            anchors.centerIn: parent
+            spacing: 2
+
+            IconImage {
+                id: appBadgeIconH
+                implicitSize: 16
+                Layout.alignment: Qt.AlignVCenter
+                source: activeAppIconSource
+            }
+
+            Tinted {
+                sourceItem: appBadgeIconH
+                anchors.fill: appBadgeIconH
+            }
+
+            Text {
+                id: appBadgeLabelH
+                Layout.alignment: Qt.AlignVCenter
+                font.family: Config.theme.font
+                font.pixelSize: Math.max(10, Config.theme.fontSize - 1)
+                font.weight: Font.DemiBold
+                color: Colors.overBackground
+                text: activeAppName
+                elide: Text.ElideRight
+            }
+        }
+
+        // Vertical layout: icon only
+        ColumnLayout {
+            id: appBadgeCol
+            visible: orientation === "vertical"
+            anchors.centerIn: parent
+            spacing: 0
+
+            IconImage {
+                id: appBadgeIconV
+                implicitSize: 16
+                Layout.alignment: Qt.AlignHCenter
+                source: activeAppIconSource
+            }
+
+            Tinted {
+                sourceItem: appBadgeIconV
+                anchors.fill: appBadgeIconV
+            }
+        }
+    }
